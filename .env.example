# Copy to backend/.env to override defaults. NO secrets are required:
# everything works offline (deterministic safety rules + offline knowledge base + demo mode).

# --- Profile shown in the app ---
# (Optional: names are normally set in the app under Caregiver → Profile & settings)
# USER_NAME=
# CAREGIVER_NAME=

# --- Optional AI: Claude for friendlier, open-ended health explanations + pill-label reading ---
# The LLM never decides emergencies. Without a key, the offline knowledge base answers.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional caregiver phone alerts via Telegram (create a bot with @BotFather) ---
# Alert several caregivers by listing their chat IDs separated by commas, e.g. 111111111,222222222
# (each caregiver must first send /start to the bot so it is allowed to message them).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Safety thresholds (see backend/app/config.py for meaning) ---
CHECKIN_TIMEOUT_S=20
FALL_WINDOW_S=1.5
FALL_MIN_DROP_TORSO=0.6
FALL_MIN_TORSO=0.08
FALL_MAX_GROWTH=1.5
FALL_MIN_DROP=0.20
FALL_UPRIGHT_ANGLE=35
FALL_HORIZONTAL_ANGLE=60
FALL_STILL_S=2.0
INACTIVITY_MIN_S=600
MED_GRACE_S=3600

# --- Vitals: 0 = only real readings (entered in the app or posted to /api/vitals). 1 = simulated stream (demo only) ---
VITALS_SIM=0


# Demo only: seed 6 days of clearly-labelled SIMULATED history so charts aren't empty
SEED_DEMO_HISTORY=0

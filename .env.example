# Copy to backend/.env to override defaults. NO secrets are required:
# everything works offline (deterministic safety rules + offline knowledge base + demo mode).

# --- Profile shown in the app ---
USER_NAME=Mak Cik Aminah
CAREGIVER_NAME=Farid (son)

# --- Optional AI: Claude for friendlier, open-ended health explanations + pill-label reading ---
# The LLM never decides emergencies. Without a key, the offline knowledge base answers.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional caregiver phone alerts via Telegram (create a bot with @BotFather) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Safety thresholds (see backend/app/config.py for meaning) ---
CHECKIN_TIMEOUT_S=20
FALL_WINDOW_S=1.5
FALL_MIN_DROP=0.20
FALL_UPRIGHT_ANGLE=35
FALL_HORIZONTAL_ANGLE=60
FALL_STILL_S=2.0
INACTIVITY_MIN_S=600
MED_GRACE_S=3600

# --- Vitals: simulated home device stream (set 0 when a real device posts to /api/vitals) ---
VITALS_SIM=1

# --- Camera: browser (default, uses the device's own webcam) | server (OpenCV on this PC) ---
CAMERA_MODE=browser
CAMERA_INDEX=0

# Seed 6 days of clearly-labelled simulated history so charts aren't empty
SEED_DEMO_HISTORY=1
